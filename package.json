{
  "name": "youdata",
  "version": "0.6.0",
  "description": "Universal concurrent single-file database platform with TCP, HTTP, WebSocket, pub/sub, TTL, data structures, SQL API, WAL recovery, schemas, indexes, and transactions.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "youdata": "src/cli.js",
    "youdata-server": "src/server.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./schema": "./src/schema.js",
    "./server": "./src/server.js",
    "./client": "./src/client.js",
    "./sql": "./src/sql.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "database",
    "embedded-database",
    "single-file",
    "tcp",
    "concurrency",
    "ttl",
    "pubsub",
    "transactions"
  ],
  "author": {
    "name": "SoyMaycol (Zyn)",
    "url": "https://github.com/toZyn"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toZyn/YouData.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
